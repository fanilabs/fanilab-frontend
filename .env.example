# This is a static showcase site — no environment variables are required to run it.

# Optional: used only to build absolute Open Graph/canonical URLs.
# Leave unset locally and on Vercel (VERCEL_URL is provided automatically at build time).
# NEXT_PUBLIC_SITE_URL=https://your-deployment-url.vercel.app

# Optional: base URL of a locally running FaniLab backend, used only by the
# server-rendered "Live Backend Data" section to call GET /api/v1/deliveries.
# Server-side only (deliberately not NEXT_PUBLIC_) so it's never sent to the
# browser. Leave unset to have that section render an honest "not configured"
# state instead of live data — do not point this at a production URL.
# BACKEND_API_URL=http://localhost:4000
